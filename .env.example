# Copy to .env and fill in. .env is gitignored — never commit real values.

# ── Required ────────────────────────────────────────────────────────────────

# Secret used to sign session JWTs. The server refuses to start without it.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# ── Postgres ────────────────────────────────────────────────────────────────
# With docker-compose these values CREATE the bundled database and its role, so
# any password you choose here works. Pointing at your own Postgres instead?
# Then the role and database must already exist and these must match it — see
# "Running without Docker" in the README.
#
# Note: compose applies user/db/password only when the data volume is first
# created. Changing them later has no effect unless you recreate the volume.

PG_USER=oracle
PG_PASSWORD=
PG_DB=ai_lab_oracle
PG_HOST=postgres
PG_PORT=5432

# ── App ─────────────────────────────────────────────────────────────────────
# Host port to publish on. Change it if 3000 is already taken on your machine.
APP_PORT=3000

# ── AI providers — configure at least one ───────────────────────────────────

# Google Gemini. Get a key at https://aistudio.google.com/app/apikey
# Can also be set per-user in the app's settings panel instead of here.
GEMINI_API_KEY=

# Any OpenAI-compatible chat completions endpoint (vLLM, Ollama, LM Studio,
# llama.cpp, LocalAI...). LOCAL_AI_MODEL must match a model that server serves.
LOCAL_AI_URL=http://localhost:8000/v1/chat/completions
LOCAL_AI_MODEL=local-model
# Optional. Sent as "Authorization: Bearer ..." if your endpoint requires auth.
LOCAL_AI_API_KEY=

# ── Note on app logins ──────────────────────────────────────────────────────
# The username and password you sign in to the app with are NOT set here. You
# create those by registering in the web UI on first run; they are stored,
# bcrypt-hashed, in Postgres. Nothing above is an application login.
